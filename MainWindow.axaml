<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Qingtu.MainWindow"
        Title="轻图"
        Width="520" Height="720" MinWidth="480" MinHeight="640"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
        <StackPanel>
            <TextBlock Text="轻图" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TealBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="把体积压下去，细节留住" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock Text="本地处理 · 不上传 · PNG / JPG / WebP" Foreground="{StaticResource MutedBrush}" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,2,0,14"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="BtnTabCompress" Content="压缩" Click="OnTabCompress" Margin="0,0,8,0"/>
                <Button x:Name="BtnTabStitch" Content="拼接" Click="OnTabStitch"/>
            </StackPanel>

            <Border x:Name="DropZone" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource TealBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtDropHint" Text="拖拽图片到这里" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                    <Button Content="选择图片" Background="{StaticResource OrangeBrush}" Foreground="White"
                            Margin="0,10,0,0" Padding="16,8" Click="OnPickFiles"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Height="100" Margin="0,0,0,12">
                <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"/>
            </Border>

            <Border x:Name="PanelCompress" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10" ColumnDefinitions="56,*,36">
                        <TextBlock Text="质量" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <Slider x:Name="SliderQuality" Grid.Column="1" Minimum="1" Maximum="100" Value="80" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtQuality" Grid.Column="2" Text="80" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,10" ColumnDefinitions="56,Auto,*">
                        <TextBlock Text="最长边" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtMaxSide" Grid.Column="1" Width="72" Text="0" VerticalAlignment="Center"
                                 Background="{StaticResource InputBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                        <TextBlock Grid.Column="2" Text="px（0 = 不缩放）" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="输出格式" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FmtKeep" Content="保持原格式" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                        <RadioButton x:Name="FmtJpeg" Content="JPEG" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                        <RadioButton x:Name="FmtPng" Content="PNG" Foreground="{StaticResource TextBrush}" Margin="0,0,12,0"/>
                        <RadioButton x:Name="FmtWebp" Content="WebP" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtStitchHint" Text="按列表顺序横向拼接，高度对齐最短边" Foreground="{StaticResource MutedBrush}"
                       Margin="0,0,0,12" IsVisible="False"/>

            <CheckBox x:Name="ChkCustomOut" Content="自定义输出目录" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,12" ColumnDefinitions="*,Auto">
                <TextBox x:Name="TxtOutDir" Background="{StaticResource InputBrush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}" Padding="8,6"/>
                <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Padding="12,6" Click="OnPickOutDir"
                        Background="{StaticResource CardBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="BtnRun" Content="开始压缩 (0)" Background="{StaticResource OrangeBrush}" Foreground="White"
                        Padding="16,8" Click="OnRun"/>
                <Button Content="清空列表" Margin="10,0,0,0" Padding="14,8" Click="OnClear"
                        Background="{StaticResource CardBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
            </StackPanel>

            <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" MinHeight="72" Padding="8">
                <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="12"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
